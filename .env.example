LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CRM_WEBHOOK_URL=
CRM_PROVIDER=generic
CRM_AUTH_TOKEN=
CALENDAR_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# LiveKit Egress can write MP4 recordings to any S3-compatible destination
# (including Cloudflare R2) and/or stream to one or more comma-separated RTMP URLs.
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_BUCKET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_FORCE_PATH_STYLE=false
LIVEKIT_RTMP_URLS=
# Optional private service for generative summaries. Without it, the app uses a
# deterministic local extractive summary and never sends transcript text away.
MEMORY_GENERATION_WEBHOOK_URL=
MEMORY_GENERATION_WEBHOOK_TOKEN=
# Shared only with the approved LiveKit transcription agent.
TRANSCRIPT_INGEST_TOKEN=
PRODUCER_EMAILS=
